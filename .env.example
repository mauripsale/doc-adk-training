# ==============================================================================
# 🤖 Google ADK Training: Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Option A: Google AI Studio (API Key) - Recommended for rapid development
# Get your API key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GOOGLE_API_KEY="your-google-ai-studio-api-key-here"

# ------------------------------------------------------------------------------
# Option B: Google Cloud Vertex AI (Enterprise & Cloud Run Deployments)
# Set GOOGLE_GENAI_USE_VERTEXAI="1" to route LLM calls via Vertex AI.
# Ensure you have run: gcloud auth application-default login
# ------------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI="0"
VERTEX_AI_PROJECT_ID="your-gcp-project-id"
VERTEX_AI_LOCATION="us-central1"

# ------------------------------------------------------------------------------
# ADK Course Defaults
# ------------------------------------------------------------------------------
ADK_DEFAULT_MODEL="gemini-3.8-flash"
